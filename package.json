  "scripts": {
    "start:dev": "npx nodemon --config ./nodemon.single.json",
    "start:multi": "npx nodemon --config ./nodemon.cluster.json",
    "start:prod": "webpack && node dist/single.bundle.js",
    "start:prod:multi": "webpack && node dist/multi.bundle.js",
    "test": "jest --watch",
    "format": "prettier --write .",
    "lint": "eslint . --fix"
  },
  "dependencies": {
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "uuid": "^11.1.0",
    "webpack": "^5.99.8",
    "webpack-cli": "^6.0.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.17",
    "@types/webpack": "^5.28.5",
    "@typescript-eslint/eslint-plugin": "^8.32.0",
    "@typescript-eslint/parser": "^8.32.0",
    "dotenv": "^16.5.0",
    "eslint": "^9.26.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "prettier": "^3.5.3",
    "ts-jest": "^29.3.2"
  }
}
